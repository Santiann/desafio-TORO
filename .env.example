APP_ENV=local

API_PORT=8080
WEB_PORT=5173

# nome do servico no compose; so mude se rodar a API fora do docker
DB_HOST=db
DB_PORT=3306
DB_PORT_HOST=3306
DB_DATABASE=vendeu_ganhou
DB_USERNAME=app
DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-esta-senha-de-root

# precisa de 32 bytes ou mais, senao a API recusa a subir: openssl rand -hex 32
JWT_SECRET=troque-me
SEED_PASSWORD=troque-esta-senha-de-seed
